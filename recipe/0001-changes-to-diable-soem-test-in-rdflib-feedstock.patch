 recipe/meta.yaml | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/recipe/meta.yaml b/recipe/meta.yaml
index 81f9048..31a7a51 100644
--- a/recipe/meta.yaml
+++ b/recipe/meta.yaml
@@ -44,6 +44,7 @@ test:
     - bsddb3
     - networkx
     - pytest
